# Copy to .env.local (git-ignored) for local development. All of these are
# PUBLIC values — they end up in the browser bundle. Never put a secret here.

# The NestJS API (no trailing slash). Its CORS_ORIGINS must include this
# panel's origin, e.g. http://localhost:3001 in development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase web app config (project matrimony-platform-30b50). Same values as
# the `web` block in Frontend/lib/firebase_options.dart — public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=matrimony-platform-30b50.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=matrimony-platform-30b50
NEXT_PUBLIC_FIREBASE_APP_ID=
