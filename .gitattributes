# Normalize all text files — Git auto-detects text vs binary and stores
# text files with LF internally, checking them out with the platform's
# native line ending unless overridden below.
* text=auto

# Flutter / Dart (Frontend)
*.dart text eol=lf
*.arb text eol=lf

# Backend (NestJS/TypeScript) + shared tooling config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.prisma text eol=lf
*.sql text eol=lf

# Shared data / config formats
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never text-normalize these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.jar binary
