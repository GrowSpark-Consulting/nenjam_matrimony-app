{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "pnpm",
      "args": ["start:dev"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nenjam-backend",
        "pattern": {
          "regexp": "^(never)(match)(this)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting compilation|File change detected",
          "endsPattern": "API running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Runs the NestJS API (pnpm start:dev) on 0.0.0.0:3000. Leave running; use adb reverse to reach it over USB."
    },
    {
      "label": "Start Development",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/start_dev.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "One-command USB dev startup: starts the backend, waits for it to be ready, then sets up adb reverse and verifies /health. See docs/development/android-usb-debugging.md."
    },
    {
      "label": "Stop Development",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/stop_dev.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "Removes the tcp:3000 adb reverse mapping and stops the backend process started by 'Start Development'."
    },
    {
      "label": "ADB Reverse",
      "type": "shell",
      "command": "adb",
      "args": ["reverse", "tcp:3000", "tcp:3000"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Forward the Android device's 127.0.0.1:3000 to this machine's 127.0.0.1:3000 over USB (see docs/development/android-usb-debugging.md)."
    },
    {
      "label": "ADB Reverse: Remove All",
      "type": "shell",
      "command": "adb",
      "args": ["reverse", "--remove-all"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Remove all adb reverse port mappings."
    }
  ]
}
