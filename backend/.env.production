# Production overrides. Committed — must never contain real secrets.
# Real DATABASE_PASSWORD / JWT_SECRET / SMTP_PASSWORD values must be injected
# by the hosting platform as actual OS environment variables — dotenv does not
# override a variable that already exists in process.env, so real secrets set
# by the deploy environment always win over the placeholders below.

NODE_ENV=production
LOG_LEVEL=warn

DATABASE_NAME=nenjam_matrimony
DATABASE_PASSWORD=changeme-in-real-environment
JWT_SECRET=changeme-in-real-environment-min-16-chars
