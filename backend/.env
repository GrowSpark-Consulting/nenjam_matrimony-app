# ─────────────────────────────────────────────
# Nenjam Matrimony - Local Development
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
WEBSOCKET_PORT=3001
LOG_LEVEL=debug

# Database (Prisma + PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nenjam_matrimony
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nenjam_matrimony?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=profiles

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=matrimony-public
S3_BUCKET_PRIVATE=matrimony-private
CLOUDFRONT_DOMAIN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# Prokerala
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# Sentry
SENTRY_DSN=

# API
API_BASE_URL=https://api.dev.nenjammatrimony.com/v1
ENABLE_LOGGING=true