generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Core user identity record. firebaseUid is the primary link to
/// Firebase Authentication — every API request is verified against it.
model User {
  id                String               @id @default(uuid())
  firebaseUid       String               @unique @map("firebase_uid")
  email             String               @unique
  phone             String?              @unique
  role              UserRole             @default(USER)
  status            UserStatus           @default(PENDING_VERIFICATION)
  trustScore        Int                  @default(0) @map("trust_score")
  // Means "Hide My Profile" (exposed by the API as `hideMyProfile`): hidden
  // from Discover/Search/Near Me/digest — but only while the member has an
  // active premium subscription (hiddenFromDiscoveryWhere in @app/database).
  // Repurposed rather than renamed; the name predates that decision.
  // hidePhotosFromNonConnections is likewise honoured only for premium members.
  profileVisibleToPremiumOnly  Boolean         @default(false) @map("profile_visible_to_premium_only")
  hidePhotosFromNonConnections Boolean         @default(false) @map("hide_photos_from_non_connections")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  adminAccount      AdminAccount?
  astrologyProfile  AstrologyProfile?
  sentMessages      ChatMessage[]        @relation("SentMessages")
  chatStates        ChatParticipantState[]
  chatRoomsAsUser1  ChatRoom[]           @relation("ChatUser1")
  chatRoomsAsUser2  ChatRoom[]           @relation("ChatUser2")
  deviceTokens      DevicePushToken[]
  referralAttribution ReferralAttribution?
  receivedInterests ExpressInterest[]    @relation("ReceivedInterests")
  sentInterests     ExpressInterest[]    @relation("SentInterests")
  faceVerification  FaceVerification?
  faceVerificationAttempts FaceVerificationAttempt[]
  horoscopeRequests HoroscopeMatch[]     @relation("HoroscopeRequester")
  horoscopeTargets  HoroscopeMatch[]     @relation("HoroscopeTarget")
  kycVerifications  KycVerification[]
  messageReactions  MessageReaction[]
  notifications     Notification[]
  partnerPreference PartnerPreference?
  payments          PaymentTransaction[]
  photos            ProfilePhoto[]
  viewedBy          ProfileView[]        @relation("ViewedByUsers")
  profileViews      ProfileView[]        @relation("ViewerViews")
  refreshTokens     RefreshToken[]
  registrationStep  RegistrationStep?
  shortlistedBy     Shortlist[]          @relation("ShortlistedByUsers")
  shortlists        Shortlist[]          @relation("UserShortlists")
  supportTickets    SupportTicket[]
  trustScoreLogs    TrustScoreLog[]
  blocksReceived    UserBlock[]          @relation("BlocksReceived")
  blocksMade        UserBlock[]          @relation("BlocksMade")
  profile           UserProfile?
  quizResponses     UserQuizResponse[]
  reportsAgainst    UserReport[]         @relation("ReportsAgainst")
  reportsMade       UserReport[]         @relation("ReportsMade")
  subscriptions     UserSubscription[]
  subscriptionEvents SubscriptionEvent[]
  membershipUsage   MembershipUsageCounter[]
  membershipUsageItems MembershipUsageItem[]
  profilePrompts    UserProfilePrompt[]
  emailLogs         EmailLog[]
  settings          UserSettings?
  recommendationDismissals ProfileRecommendationDismissal[]

  @@index([firebaseUid])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

/// JWT refresh token store. Each token is single-use and hashed.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Extended admin metadata — one-to-one extension of User (role=ADMIN).
///
/// Access comes from roles (AdminUserRole → Role → Permission), checked by the
/// admin guard. An account is created inactive and switched on only by the
/// provisioning script (`pnpm admin:provision`), which also hands out the
/// one-time code needed to enrol an authenticator.
model AdminAccount {
  id                     String          @id @default(uuid())
  userId                 String          @unique @map("user_id")
  department             String          @default("PLATFORM")
  /// Legacy per-account grants written by the old seeder. No longer read:
  /// access comes from roles. Kept so no data is dropped.
  permissions            Json            @default("{}")
  isActive               Boolean         @default(false) @map("is_active")
  /// TOTP secret, AES-256-GCM encrypted with ADMIN_MFA_ENCRYPTION_KEY.
  /// Pending (not yet usable) while mfaEnrolledAt is null.
  mfaSecretEncrypted     String?         @map("mfa_secret_encrypted")
  mfaEnrolledAt          DateTime?       @map("mfa_enrolled_at")
  /// The TOTP time step of the last accepted code — a code is never
  /// accepted twice.
  mfaLastUsedStep        Int?            @map("mfa_last_used_step")
  mfaFailedAttempts      Int             @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil         DateTime?       @map("mfa_locked_until")
  /// SHA-256 of the one-time enrolment code the provisioning script printed.
  mfaEnrollmentCodeHash  String?         @map("mfa_enrollment_code_hash")
  mfaEnrollmentExpiresAt DateTime?       @map("mfa_enrollment_expires_at")
  lastLoginAt            DateTime?       @map("last_login_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                  AdminUserRole[]
  sessions               AdminSession[]

  @@map("admin_accounts")
}

/// A staff role: a named, editable bundle of permissions. Code checks
/// permissions, never role keys, so a new role needs no deploy.
model Role {
  id          String           @id @default(uuid())
  /// Stable identifier, e.g. SUPER_ADMIN.
  key         String           @unique
  name        String
  description String?
  /// Seeded by a migration; not deletable from the admin panel.
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  admins      AdminUserRole[]

  @@map("roles")
}

/// One action an admin may take, `<resource>.<action>` (e.g. agent.approve).
/// The keys are defined in code (admin/rbac/permissions.ts) and seeded by
/// migrations; the two must match (a unit test checks).
model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  /// Needs a recent second-factor check (step-up) on every use.
  isSensitive Boolean          @default(false) @map("is_sensitive")
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  adminAccountId String       @map("admin_account_id")
  roleId         String       @map("role_id")
  /// User id of the admin who assigned it; null when the provisioning
  /// script did.
  assignedById   String?      @map("assigned_by_id")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([adminAccountId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

/// Proof that an admin passed the second factor. Issued after a TOTP check
/// and sent as `X-Admin-Session` alongside the Firebase ID token; only its
/// SHA-256 is stored.
model AdminSession {
  id             String       @id @default(uuid())
  adminAccountId String       @map("admin_account_id")
  tokenHash      String       @unique @map("token_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  lastSeenAt     DateTime     @map("last_seen_at")
  expiresAt      DateTime     @map("expires_at")
  /// Last TOTP check on this session; sensitive permissions need it recent.
  mfaVerifiedAt  DateTime     @map("mfa_verified_at")
  revokedAt      DateTime?    @map("revoked_at")
  revokeReason   String?      @map("revoke_reason")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)

  @@index([adminAccountId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Full matrimonial profile — the searchable core of each member.
model UserProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique @map("user_id")
  firstName          String        @map("first_name")
  lastName           String        @map("last_name")
  /// A calendar date, stored as UTC midnight of the day it names — never a
  /// local-midnight timestamp, which drifts a day on any server east of UTC.
  /// Every write goes through `parseBirthDate` (profiles/validation/
  /// birth-date.ts); migration 20260908120000 normalised the rows that
  /// predate it. Left as TIMESTAMP rather than DATE because the feed's age
  /// mapper, the partner-preference age window, the compatibility scorer and
  /// the weekly digest all read it as one. No age is stored anywhere — the
  /// date of birth is the source of truth and age is computed from it.
  dob                DateTime
  gender             Gender
  maritalStatus      MaritalStatus @default(NEVER_MARRIED) @map("marital_status")
  religion           String
  /// Nullable: onboarding stopped asking for caste. Was NOT NULL, which left
  /// the profile write with only bad options — fabricate a placeholder, or
  /// omit the field and have Postgres reject the row. Same reasoning as
  /// heightCm below. Existing values are untouched, and Edit Profile's
  /// Religion step still writes this.
  caste              String?
  subCaste           String?       @map("sub_caste")
  community          String?
  denomination       String?
  /// Nullable for the same reason as caste — onboarding no longer asks. Read
  /// null-tolerantly by matching (SelfAttributes) and the feed mapper.
  motherTongue       String?       @map("mother_tongue")
  languagesKnown     Json          @default("[]") @map("languages_known")
  /// Nullable: Step 6 (Physical Details) is skippable. Was NOT NULL with a
  /// fake `0` written when skipped (see git blame) — that both violated the
  /// "no fake/placeholder values" rule and, once education/profession below
  /// hit the same issue, surfaced as a Prisma validation error on
  /// POST /profiles/finalize whenever a user completed only the mandatory
  /// Steps 1-4. Absence now means exactly what it says: never filled in.
  heightCm           Int?          @map("height_cm")
  weightKg           Int?          @map("weight_kg")
  annualIncomeLakhs  Decimal?      @map("annual_income_lakhs") @db.Decimal(10, 2)
  /// Nullable: Step 5 (Education & Career) is skippable — see heightCm's
  /// comment for why this must not be NOT NULL.
  highestEducation   String?       @map("highest_education")
  /// The college/university named on the Education step.
  ///
  /// Its own column since Task 2. It was previously folded into
  /// `educationDetails` below by `joinNonEmpty(college, employmentType,
  /// workLocation)`, which made it unrecoverable from the profile row — the
  /// draft kept it, the profile could not show it. `educationDetails` is
  /// left exactly as it is so nothing already stored there is lost.
  college            String?
  /// "Industry" — the sector the member works in, between employment type
  /// and role. Added by Task 2; nullable because no existing profile has one.
  workIndustry       String?       @map("work_industry")
  educationDetails   String?       @map("education_details")
  /// Nullable: Step 5 (Education & Career) is skippable — see heightCm's
  /// comment for why this must not be NOT NULL.
  profession         String?
  employerName       String?       @map("employer_name")
  currentCity        String        @map("current_city")
  currentState       String        @map("current_state")
  nativeCity         String?       @map("native_city")
  country            String?
  /// Structured location, added beside the free-text columns above rather
  /// than replacing them. Nullable and unpopulated for every existing row:
  /// legacy values ("TN", "chennai", a Singapore address filed under Kerala)
  /// stay exactly as members typed them and are never silently corrected.
  /// New registrations write both the code and the label. See
  /// seed-data/README.md for how the codes are derived.
  /// Column types match the master tables' primary keys exactly, so the
  /// foreign keys below need no implicit cast.
  countryCode        String?       @map("country_code") @db.VarChar(2)
  stateCode          String?       @map("state_code") @db.VarChar(6)
  cityCode           String?       @map("city_code") @db.VarChar(80)
  /// onDelete: Restrict, not Prisma's default SET NULL for an optional
  /// relation: retiring a city must never silently blank a member's stated
  /// location. A referenced row is deactivated, never deleted.
  countryRef         Country?      @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  stateRef           Subdivision?  @relation(fields: [stateCode], references: [code], onDelete: Restrict)
  cityRef            City?         @relation(fields: [cityCode], references: [code], onDelete: Restrict)
  area               String?
  pinCode            String?       @map("pin_code")
  /// Device-reported coordinates backing the "Near Me" proximity search.
  /// Nullable throughout, and every geo query filters `latitude IS NOT NULL`
  /// rather than leaning on a default: sharing location is opt-in (the member
  /// must grant OS location permission), and a default of 0 would not mean
  /// "unknown" — 0,0 is a real point in the Gulf of Guinea that would place
  /// every un-located member a few metres from every other one.
  ///
  /// Double precision, not a PostGIS geography type: PostGIS is not installed
  /// on this database and `CREATE EXTENSION` needs superuser rights the deploy
  /// role does not have. The bounding-box + Haversine query in
  /// NearbyRepository is exact at the radii this feature uses and needs no
  /// extension — see modules/matches/geo/haversine.ts. Moving to PostGIS later
  /// changes that one repository and nothing else.
  latitude           Float?        @map("latitude")
  longitude          Float?        @map("longitude")
  /// Accuracy radius in metres as the device reported it. Android's
  /// "Approximate" permission yields ~1-3 km here where "Precise" yields tens
  /// of metres; iOS reduced accuracy behaves the same way. Stored so the
  /// client can describe a coarse fix honestly instead of implying a
  /// precision it does not have.
  locationAccuracyM  Int?          @map("location_accuracy_m")
  /// When the coordinates above were last written. Read by the client to
  /// decide whether a stored fix is still fresh enough to reuse.
  locationUpdatedAt  DateTime?     @map("location_updated_at")
  bio                String?
  dietaryHabits      String?       @map("dietary_habits")
  smokingHabits      String?       @map("smoking_habits")
  drinkingHabits     String?       @map("drinking_habits")
  fitness            String?
  hobbies            Json          @default("[]")
  physicalStatus     String?       @map("physical_status")
  familyType         String?       @map("family_type")
  familyStatus       String?       @map("family_status")
  familyValues       String?       @map("family_values")
  fatherName         String?       @map("father_name")
  fatherAge          Int?          @map("father_age")
  fatherOccupation   String?       @map("father_occupation")
  motherName         String?       @map("mother_name")
  motherAge          Int?          @map("mother_age")
  motherOccupation   String?       @map("mother_occupation")
  siblings           Int?
  /// Structured per-sibling records: [{ relation: "BROTHER"|"SISTER", name, age, occupation }].
  /// `siblings` (the aggregate count) is kept in sync from this array's length
  /// going forward so any existing code still querying the plain count keeps working.
  siblingDetails     Json          @default("[]") @map("sibling_details")
  isProfileComplete  Boolean       @default(false) @map("is_profile_complete")
  profileCompletePct Int           @default(0) @map("profile_complete_pct")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
  @@index([religion])
  @@index([caste])
  @@index([heightCm])
  @@index([annualIncomeLakhs])
  @@index([currentCity])
  @@index([currentState])
  // Mirror the free-text indexes above for the structured columns. Search
  // filters by code once a profile has one, and falls back to the text
  // columns for profiles that predate the migration.
  @@index([cityCode])
  @@index([stateCode])
  @@index([countryCode])
  // Serves the Near Me bounding-box prefilter (`latitude BETWEEN ? AND ?` /
  // `longitude BETWEEN ? AND ?`). Latitude leads because it is the more
  // selective of the two here: one degree of latitude is a constant ~111km,
  // while at Indian latitudes one degree of longitude is only ~101km, so an
  // equal-distance box is narrower in degrees north-south than east-west and
  // the planner discards more rows on the leading range scan.
  @@index([latitude, longitude])
  @@index([gender, religion, caste, annualIncomeLakhs])
  // Serves the Discover/Search feed, which is always "opposite gender, newest
  // first, paginated". Without the createdAt column here the planner filters on
  // gender and then SORTS every matching profile on every page request
  // (confirmed with EXPLAIN: `Sort Key: created_at DESC` above an index scan on
  // the composite above). With it the scan comes back already ordered, so a
  // page reads only the rows it returns however large the table grows.
  @@index([gender, createdAt])
  @@map("user_profiles")
}

/// Profile photo gallery. Primary photo drives discovery cards.
model ProfilePhoto {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  s3Key      String   @map("s3_key")
  cdnUrl     String   @map("cdn_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  order      Int      @default(0)
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Face verifications whose match was made against this photo. Deleting the
  /// photo nulls the link (SetNull), which by itself invalidates the badge —
  /// see FaceVerification.
  faceVerificationsMatched FaceVerification[]        @relation("FaceVerificationMatchedPhoto")
  /// Attempts that compared a liveness selfie against this photo.
  faceVerificationAttempts FaceVerificationAttempt[] @relation("FaceVerificationAttemptComparedPhoto")

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("profile_photos")
}

/// Partner preference criteria used for AI matching and search filters.
model PartnerPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  /// Age and height bounds. NULL means no limit on that side — what "Any"
  /// and an unset range both mean. They used to default to 18-45 and
  /// 140-210, which quietly acted as real filters: a member who never chose
  /// an age still excluded everyone over 45, and every missing height.
  minAge                 Int?     @map("min_age")
  maxAge                 Int?     @map("max_age")
  minHeightCm            Int?     @map("min_height_cm")
  maxHeightCm            Int?     @map("max_height_cm")
  preferredReligions     Json     @default("[]") @map("preferred_religions")
  preferredCastes        Json     @default("[]") @map("preferred_castes")
  minIncomeLakhs         Decimal? @map("min_income_lakhs") @db.Decimal(10, 2)
  preferredCities        Json     @default("[]") @map("preferred_cities")
  preferredStates        Json     @default("[]") @map("preferred_states")
  preferredEducation     Json     @default("[]") @map("preferred_education")
  preferredOccupations   Json     @default("[]") @map("preferred_occupations")
  preferredMotherTongues Json     @default("[]") @map("preferred_mother_tongues")
  maritalStatusPref      Json     @default("[]") @map("marital_status_pref")
  // Advanced preference fields (religion/community, education/career,
  // family, lifestyle, location, special cases, verification filters, and
  // per-criterion matching-engine requirement tags) collected by the
  // standalone Partner Preferences page. Stored as a free-form JSON blob —
  // mirrors Frontend's PartnerPreferenceExtended.toJson() — rather than one
  // column per field, so the client's field set can evolve without a
  // migration for every addition.
  extendedPreferences    Json     @default("{}") @map("extended_preferences")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("partner_preferences")
}

/// Tracks which of the 12 registration steps a user has completed.
model RegistrationStep {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  currentStep    Int      @default(1) @map("current_step")
  totalSteps     Int      @default(12) @map("total_steps")
  completedSteps Json     @default("[]") @map("completed_steps")
  draftData      Json     @default("{}") @map("draft_data")
  lastSavedAt    DateTime @default(now()) @map("last_saved_at")
  isComplete     Boolean  @default(false) @map("is_complete")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("registration_steps")
}

/// One profile-completion recommendation card the member has dismissed from
/// Home / Edit Profile.
///
/// A dismissal hides the *suggestion*, never the data behind it: there is no
/// column here that any profile section reads, and deleting a row simply
/// makes the card eligible to be shown again. That separation is the whole
/// point — "I don't want to be asked about my horoscope" and "I have no
/// horoscope details" are different statements, and the old client-only
/// dismissal could not tell them apart across a reinstall or a re-login.
///
/// [cardKey] is the stable recommendation id shared with the Flutter client
/// (`about_family`, `horoscope`, `verification`, `psychology`,
/// `registration`, `photo` — see profiles/domain/recommendation-cards.ts and
/// Frontend .../domain/completion_recommendation.dart). Deliberately a String
/// rather than an enum: adding a card must not require a migration, and an
/// unknown key read back is ignored by both sides rather than throwing.
model ProfileRecommendationDismissal {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  cardKey     String   @map("card_key")
  dismissedAt DateTime @default(now()) @map("dismissed_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardKey])
  @@index([userId])
  @@map("profile_recommendation_dismissals")
}

/// Horoscope details for traditional Porutham / Koota matching.
model AstrologyProfile {
  id                 String     @id @default(uuid())
  userId             String     @unique @map("user_id")
  /// The member's `UserProfile.dob`, not a second answer — same value, same
  /// UTC-midnight calendar-date invariant. `birthTime` below holds the time
  /// of birth, which is why this one never carries one.
  birthDate          DateTime   @map("birth_date")
  birthTime          String?    @map("birth_time")
  birthPlace         String?    @map("birth_place")
  birthLat           Decimal?   @map("birth_lat") @db.Decimal(10, 7)
  birthLng           Decimal?   @map("birth_lng") @db.Decimal(10, 7)
  rasi               String?
  nakshatra          String?
  lagnam             String?
  gotram             String?
  dosham             DoshamType @default(NONE)
  horoscopeAvailable Boolean    @default(false) @map("horoscope_available")
  rawChart           Json?      @map("raw_chart")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("astrology_profiles")
}

/// Result cache for 10-Porutham compatibility calculations.
model HoroscopeMatch {
  id              String   @id @default(uuid())
  requesterId     String   @map("requester_id")
  targetId        String   @map("target_id")
  poruthamScore   Int      @map("porutham_score")
  poruthamDetails Json     @map("porutham_details")
  calculatedAt    DateTime @default(now()) @map("calculated_at")
  requester       User     @relation("HoroscopeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target          User     @relation("HoroscopeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
  @@map("horoscope_matches")
}

/// Express interest (like / send interest) between two members.
model ExpressInterest {
  id          String         @id @default(uuid())
  senderId    String         @map("sender_id")
  receiverId  String         @map("receiver_id")
  status      InterestStatus @default(PENDING)
  royalNote   String?        @map("royal_note")
  respondedAt DateTime?      @map("responded_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  receiver    User           @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User           @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  // Serve the paginated received/sent lists (WHERE receiver/sender ORDER BY
  // created_at DESC) from a single index instead of a filter + sort.
  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
  @@map("express_interests")
}

/// Saved / shortlisted profiles (like a favourites list).
model Shortlist {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  targetUserId String   @map("target_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  targetUser   User     @relation("ShortlistedByUsers", fields: [targetUserId], references: [id], onDelete: Cascade)
  user         User     @relation("UserShortlists", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
  // Serve the paginated shortlist list (WHERE user ORDER BY created_at DESC).
  @@index([userId, createdAt])
  @@map("shortlists")
}

/// Profile view event log — "who viewed my profile".
model ProfileView {
  id           String   @id @default(uuid())
  viewerId     String   @map("viewer_id")
  viewedUserId String   @map("viewed_user_id")
  viewedAt     DateTime @default(now()) @map("viewed_at")
  viewedUser   User     @relation("ViewedByUsers", fields: [viewedUserId], references: [id], onDelete: Cascade)
  viewer       User     @relation("ViewerViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([viewedUserId])
  @@index([viewerId])
  @@index([viewedAt])
  // "Who viewed me" groups this table by viewer for one viewed user. This table
  // grows fastest of any (a row per profile open), so let that grouping run off
  // an ordered index scan instead of gathering and hashing the viewed user's
  // whole view history.
  @@index([viewedUserId, viewerId])
  @@map("profile_views")
}

/// Psychology questionnaire definition (versioned, one active quiz at a
/// time). Generic on purpose: as of the marriage-compatibility question set
/// this holds no OCEAN-specific fields — question shape lives entirely on
/// QuizQuestion, so retiring/replacing a questionnaire is a new PsychologyQuiz
/// row (new id/version), never a column change here.
model PsychologyQuiz {
  id          String             @id @default(uuid())
  title       String
  description String?
  version     String             @default("1.0")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  questions   QuizQuestion[]
  responses   UserQuizResponse[]

  @@map("psychology_quizzes")
}

/// A single scenario-based question. `options` carries the structured
/// single-select choices ({key,label,value}[]); `pairRules` carries the
/// scoring/flag rules for how two users' answers to this question compare
/// (a small option-pair -> outcome table, not a generic distance formula —
/// see the marriage-compatibility quiz spec). Both are opaque Json here
/// because their shape is quiz-content, scored entirely by the psychology
/// module — this table has no knowledge of scoring itself.
model QuizQuestion {
  id           String              @id @default(uuid())
  quizId       String              @map("quiz_id")
  dimension    String
  scoringType  QuestionScoringType @map("scoring_type")
  questionText String              @map("question_text")
  /// [{ key: "A", label: "...", value: 1 }, ...]
  options      Json
  /// [{ pair: ["A","B"], type: "flag", severity: "soft", message: "..." }, ...]
  pairRules    Json                @default("[]") @map("pair_rules")
  order        Int
  createdAt    DateTime            @default(now()) @map("created_at")
  quiz         PsychologyQuiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // A quiz has one question per position and per dimension. The scorer keys
  // cross-question rules by dimension, so a duplicate would silently overwrite
  // another question's result; a duplicate order makes "the quiz" ambiguous.
  @@unique([quizId, order])
  @@unique([quizId, dimension])
  @@index([quizId])
  @@index([dimension])
  @@map("quiz_questions")
}

/// A user's submitted answers to one quiz. No computed score is stored here:
/// this quiz's scoring (pair-rule matrices, flags, hard-axis ceiling) is
/// inherently pairwise, computed from two users' `answers` at compatibility
/// time — there is no single-user result to cache. Re-taking the same
/// (still-active) quiz upserts this row; a retired/replaced quiz gets a new
/// PsychologyQuiz id, so old answers are never overwritten by a new
/// questionnaire version.
model UserQuizResponse {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  quizId      String         @map("quiz_id")
  /// { questionId: selectedOptionKey }
  answers     Json
  /// PsychologyQuiz.version the answers were given against. Null on rows that
  /// predate this column, which are treated as current. Bumping a quiz's
  /// version is how a content change invalidates existing answers without a
  /// new quiz id: scoring ignores a response whose version differs from the
  /// active quiz's. (A CHECK constraint, added in SQL, keeps `answers` an
  /// object.)
  quizVersion String?        @map("quiz_version")
  /// When this set of answers was completed — refreshed on a retake, and what
  /// the retake cooldown counts from.
  completedAt DateTime       @default(now()) @map("completed_at")
  // `@default(now())` mirrors the DEFAULT CURRENT_TIMESTAMP the migration had
  // to give this column: it was added NOT NULL to a table with existing rows,
  // which needs a default to backfill them. Declaring only `@updatedAt` left
  // the schema saying "no default" while the database had one, and the CI
  // drift check failed on exactly that.
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  // Restrict, not Cascade: deleting a quiz must not silently delete every
  // member's answers to it (a retired quiz is deactivated, never deleted).
  quiz        PsychologyQuiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@map("user_quiz_responses")
}

/// Catalogue of pickable profile prompts (Hinge/Jeevansathi-style) — see
/// Frontend/lib/features/profile_prompts. Category names mirror the Flutter
/// PromptCategory enum (SCREAMING_SNAKE here, camelCase there).
model PromptBankItem {
  id         String              @id @default(uuid())
  category   PromptCategory
  promptText String              @map("prompt_text")
  isActive   Boolean             @default(true) @map("is_active")
  order      Int                 @default(0)
  createdAt  DateTime            @default(now()) @map("created_at")
  answers    UserProfilePrompt[]

  @@index([category])
  @@map("prompt_bank_items")
}

/// A user's chosen prompt + written answer. Capped at 3 per user, enforced
/// in PromptsService — see ChoosePromptPage's max-3 UI limit.
model UserProfilePrompt {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  promptId   String         @map("prompt_id")
  answerText String         @map("answer_text")
  order      Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt     PromptBankItem @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
  @@map("user_profile_prompts")
}

/// The membership plan catalogue — Free, Gold, Platinum (SILVER is retired,
/// kept inactive for history). One row per plan; what a plan grants lives in
/// its immutable SubscriptionPlanVersion rows and what it costs in its
/// SubscriptionPlanDuration rows. See docs/membership/README.md.
model SubscriptionPlan {
  id            String               @id @default(uuid())
  name          SubscriptionPlanName @unique
  displayName   String               @map("display_name")
  /// LEGACY — superseded by SubscriptionPlanDuration.priceInPaise. Kept only
  /// because it is NOT NULL on existing rows; nothing reads it.
  priceInr      Int                  @map("price_inr")
  /// LEGACY — superseded by SubscriptionPlanDuration.durationDays.
  durationDays  Int                  @map("duration_days")
  /// LEGACY — superseded by SubscriptionPlanVersion.entitlements.
  features      Json                 @default("[]")
  /// LEGACY — superseded by SubscriptionPlanVersion.entitlements.
  limits        Json                 @default("{}")
  /// Whether the plan is offered for purchase. Deactivating never touches
  /// existing subscriptions; FREE can never be deactivated.
  isActive      Boolean              @default(true) @map("is_active")
  description   String?
  /// Rank for upgrade/downgrade and "highest plan wins": FREE 0, GOLD 1,
  /// PLATINUM 2.
  tier          Int                  @default(0)
  displayOrder  Int                  @default(0) @map("display_order")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  subscriptions UserSubscription[]
  durations     SubscriptionPlanDuration[]
  versions      SubscriptionPlanVersion[]
  drafts        SubscriptionPlanDraft[]

  @@map("subscription_plans")
}

/// A proposed change to a plan — its entitlements and/or price list — made in
/// the admin panel and published only after a SECOND admin approves it
/// (maker-checker). Publishing creates a new immutable SubscriptionPlanVersion
/// (if the entitlements changed) and updates the durations, in one
/// transaction. At most one open (DRAFT or SUBMITTED) draft per plan.
model SubscriptionPlanDraft {
  id                 String          @id @default(uuid())
  planId             String          @map("plan_id")
  /// The version that was current when the draft was started.
  baseVersionId      String?         @map("base_version_id")
  /// The complete proposed entitlement map.
  entitlements       Json
  /// The complete proposed price list:
  /// [{ months, durationDays, bonusDays, priceInPaise, isActive }].
  durations          Json            @default("[]")
  changeNote         String          @map("change_note")
  status             PlanDraftStatus @default(DRAFT)
  createdById        String          @map("created_by_id")
  updatedById        String          @map("updated_by_id")
  submittedById      String?         @map("submitted_by_id")
  submittedAt        DateTime?       @map("submitted_at")
  /// Who published or rejected it — never the submitter.
  decidedById        String?         @map("decided_by_id")
  decidedAt          DateTime?       @map("decided_at")
  decisionNote       String?         @map("decision_note")
  publishedVersionId String?         @map("published_version_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@index([status, updatedAt])
  @@map("subscription_plan_drafts")
}

/// A purchasable length of a plan and its CURRENT price. Historical prices
/// are never read from here — each subscription and payment snapshots what
/// was actually charged.
model SubscriptionPlanDuration {
  id            String             @id @default(uuid())
  planId        String             @map("plan_id")
  /// Marketing length (3 / 6 / 12). Unique per plan.
  months        Int
  durationDays  Int                @map("duration_days")
  bonusDays     Int                @default(0) @map("bonus_days")
  /// Price in paise. Null means not priced yet, which also means not
  /// purchasable: an unpriced duration can never be activated.
  priceInPaise  Int?               @map("price_in_paise")
  currency      String             @default("INR")
  isActive      Boolean            @default(false) @map("is_active")
  displayOrder  Int                @default(0) @map("display_order")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions UserSubscription[]

  @@unique([planId, months])
  @@map("subscription_plan_durations")
}

/// An immutable snapshot of what a plan grants, keyed by stable feature ids
/// (see apps/api/src/modules/entitlements/catalog/feature-catalog.ts). A
/// configuration change is a NEW version, never an edit: subscriptions pin
/// the version they were bought under, so a change can't silently alter
/// benefits someone already paid for. Free members follow the FREE plan's
/// version with the latest effectiveFrom <= now.
model SubscriptionPlanVersion {
  id            String             @id @default(uuid())
  planId        String             @map("plan_id")
  version       Int
  entitlements  Json
  effectiveFrom DateTime           @map("effective_from")
  changeNote    String?            @map("change_note")
  /// The admin user who published it; null for system/migration versions.
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions UserSubscription[]

  @@unique([planId, version])
  @@index([planId, effectiveFrom])
  @@map("subscription_plan_versions")
}

/// A user's active or historical subscription to a plan. Members with no
/// current row are Free. A row grants its plan only while ACTIVE and
/// startDate <= now < endDate, so a row nobody flipped to EXPIRED still stops
/// counting on its end date.
model UserSubscription {
  id                 String               @id @default(uuid())
  userId             String               @map("user_id")
  planId             String               @map("plan_id")
  status             SubscriptionStatus   @default(PENDING)
  startDate          DateTime             @map("start_date")
  endDate            DateTime             @map("end_date")
  razorpaySubId      String?              @map("razorpay_sub_id")
  autoRenew          Boolean              @default(false) @map("auto_renew")
  /// The entitlement snapshot this subscription was sold under. Null only on
  /// rows that predate plan versions; those resolve to the version effective
  /// at their startDate.
  planVersionId      String?              @map("plan_version_id")
  durationId         String?              @map("duration_id")
  /// What was charged, in paise (0 for an admin grant) — a snapshot, so later
  /// price changes never rewrite history.
  priceInPaise       Int?                 @map("price_in_paise")
  currency           String?
  source             SubscriptionSource   @default(PURCHASE)
  activatedAt        DateTime?            @map("activated_at")
  /// Set when the member cancels (access continues to endDate) or when
  /// access is revoked (refund / admin), together with the reason.
  cancelledAt        DateTime?            @map("cancelled_at")
  cancellationReason String?              @map("cancellation_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  payments           PaymentTransaction[]
  events             SubscriptionEvent[]
  plan               SubscriptionPlan     @relation(fields: [planId], references: [id])
  planVersion        SubscriptionPlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  duration           SubscriptionPlanDuration? @relation(fields: [durationId], references: [id], onDelete: Restrict)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  // The membership resolver's query: a member's ACTIVE rows still in force.
  @@index([userId, status, endDate])
  @@map("user_subscriptions")
}

/// Append-only lifecycle history of a subscription: every status change and
/// every lifecycle exception, with who caused it.
model SubscriptionEvent {
  id             String                @id @default(uuid())
  subscriptionId String                @map("subscription_id")
  userId         String                @map("user_id")
  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?   @map("from_status")
  toStatus       SubscriptionStatus?   @map("to_status")
  /// Who caused it: the member, an admin, or null for the system (webhook,
  /// expiry sweep).
  actorId        String?               @map("actor_id")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  subscription   UserSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
  @@map("subscription_events")
}

/// Individual Razorpay payment transaction records.
model PaymentTransaction {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  subscriptionId    String           @map("subscription_id")
  razorpayOrderId   String?          @unique @map("razorpay_order_id")
  razorpayPaymentId String?          @unique @map("razorpay_payment_id")
  /// Amount in paise
  amountInr         Int              @map("amount_inr")
  currency          String           @default("INR")
  status            PaymentStatus    @default(PENDING)
  paidAt            DateTime?        @map("paid_at")
  failureReason     String?          @map("failure_reason")
  /// Total refunded so far, in paise. A full refund also flips status to
  /// REFUNDED; a partial one only accumulates here.
  refundedAmount    Int              @default(0) @map("refunded_amount")
  refundedAt        DateTime?        @map("refunded_at")
  metadata          Json?
  /// Who paid: the member in the app, an agent for them, or an admin
  /// recording cash/UPI received.
  paidBy             PaymentPaidBy         @default(MEMBER) @map("paid_by")
  /// False for a Razorpay TEST-mode payment (no money moved); set from the key
  /// in use at checkout. Null on rows from before this column.
  livemode           Boolean?
  /// The pricing fixed at checkout, in paise. GST is added on top:
  ///   taxable = list − discount; tax = round(taxable × rate / 10000);
  ///   amountInr = taxable + tax.
  /// Null on rows from before these columns (they were list price only).
  listAmountPaise    Int?                  @map("list_amount_paise")
  discountPaise      Int                   @default(0) @map("discount_paise")
  discountSource     PaymentDiscountSource @default(NONE) @map("discount_source")
  /// The referral code quoted at checkout. A plain id, no foreign key: the
  /// payment record must outlive any code.
  heldReferralCodeId String?               @map("held_referral_code_id")
  taxableAmountPaise Int?                  @map("taxable_amount_paise")
  taxRateBps         Int?                  @map("tax_rate_bps")
  taxPaise           Int?                  @map("tax_paise")
  /// Set when the payment succeeds: no earlier successful payment by this
  /// member. Only a first paid plan can earn an agent commission.
  isFirstPaidPlan    Boolean               @default(false) @map("is_first_paid_plan")
  /// Keyed hash of the payer's UPI id when Razorpay reports one (abuse
  /// checks); never the id itself.
  paymentSourceHash  String?               @map("payment_source_hash")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  subscription      UserSubscription @relation(fields: [subscriptionId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@map("payment_transactions")
}

/// Payment events for other features (the agent program), written in the
/// SAME transaction as the payment change and delivered after commit — at
/// least once, oldest first, until a subscriber accepts them. `dedupeKey`
/// makes writing one twice a no-op.
model PaymentEventOutbox {
  id          String    @id @default(uuid())
  /// `payment.succeeded` | `payment.refunded` (libs/common referral-events).
  type        String
  /// `<type>:<paymentId>` or `<type>:<refundId>`.
  dedupeKey   String    @unique @map("dedupe_key")
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([deliveredAt, createdAt])
  @@map("payment_event_outbox")
}

/// Every payment-provider webhook delivery accepted, keyed by the provider's
/// own event id. Inserted in the same transaction that applies the event, so
/// a redelivered event is a no-op and a failed one rolls back and can be
/// retried. Stores ids and a payload hash only — never the payload, which
/// carries the payer's contact details.
model PaymentWebhookEvent {
  id            String               @id @default(uuid())
  provider      String
  eventId       String               @map("event_id")
  eventType     String               @map("event_type")
  status        PaymentWebhookStatus
  orderId       String?              @map("order_id")
  paymentId     String?              @map("payment_id")
  payloadSha256 String               @map("payload_sha256")
  detail        String?
  receivedAt    DateTime             @default(now()) @map("received_at")

  @@unique([provider, eventId])
  // The event-id header is not covered by the signature, so a replayed
  // signed body with a fresh header must still be caught: byte-identical
  // bodies are the same event (Razorpay's own retries resend the same bytes).
  @@unique([provider, payloadSha256])
  @@index([orderId])
  @@map("payment_webhook_events")
}

/// How much of a metered feature a member has used in one period. Written
/// only by an atomic conditional upsert (UsageRepository), so concurrent
/// requests can never take it past its limit. `periodKey` is the IST calendar
/// day ("D:2026-10-27"), IST month ("M:2026-10"), or a subscription's own
/// pool ("S:<subscription id>").
model MembershipUsageCounter {
  userId       String    @map("user_id")
  feature      String
  periodKey    String    @map("period_key")
  used         Int       @default(0)
  periodEndsAt DateTime? @map("period_ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature, periodKey])
  @@index([periodEndsAt])
  @@map("membership_usage_counters")
}

/// The individual items already charged against a counter, for features
/// metered per distinct item (a profile browsed today, a contact unlocked):
/// charging the same item twice in one period costs once.
model MembershipUsageItem {
  userId    String   @map("user_id")
  feature   String
  periodKey String   @map("period_key")
  itemKey   String   @map("item_key")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature, periodKey, itemKey])
  @@map("membership_usage_items")
}

/// A private chat room between exactly two users (mutual match).
model ChatRoom {
  id            String        @id @default(uuid())
  user1Id       String        @map("user1_id")
  user2Id       String        @map("user2_id")
  isActive      Boolean       @default(true) @map("is_active")
  lastMessageAt DateTime?     @map("last_message_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  messages      ChatMessage[]
  participantStates ChatParticipantState[]
  user1         User          @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User          @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
  @@map("chat_rooms")
}

/// Per-user, per-room state — the settings that belong to ONE participant, not
/// the shared room: pin/mute/archive, "mark unread", per-user delete
/// (`deletedUntil` — the room stays hidden until a newer message arrives),
/// read-position, and per-conversation notification override. One row per
/// (room, user).
model ChatParticipantState {
  id                 String    @id @default(uuid())
  roomId             String    @map("room_id")
  userId             String    @map("user_id")
  isPinned           Boolean   @default(false) @map("is_pinned")
  isMuted            Boolean   @default(false) @map("is_muted")
  isArchived         Boolean   @default(false) @map("is_archived")
  markUnread         Boolean   @default(false) @map("mark_unread")
  lastReadMessageId  String?   @map("last_read_message_id")
  lastReadAt         DateTime? @map("last_read_at")
  deletedUntil       DateTime? @map("deleted_until")
  customNotification String?   @map("custom_notification")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  room               ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_participant_states")
}

/// Individual chat message within a room.
model ChatMessage {
  id        String            @id @default(uuid())
  roomId    String            @map("room_id")
  senderId  String            @map("sender_id")
  content   String
  type      MessageType       @default(TEXT)
  mediaUrl  String?           @map("media_url")
  /// Client-generated idempotency key. Unique per sender so a retried send
  /// (same key) returns the existing message instead of inserting a duplicate.
  clientMessageId String?     @map("client_message_id")
  /// Server-side delivery progression: SENT -> DELIVERED (recipient's socket
  /// received it) -> READ. PENDING/FAILED are client-only optimistic states.
  status    MessageDeliveryStatus @default(SENT)
  deliveredAt DateTime?       @map("delivered_at")
  isRead    Boolean           @default(false) @map("is_read")
  readAt    DateTime?         @map("read_at")
  editedAt  DateTime?         @map("edited_at")
  deletedAt DateTime?         @map("deleted_at")
  createdAt DateTime          @default(now()) @map("created_at")
  /// The message this one replies to, if any — nullable self-relation.
  /// `SetNull` rather than `Cascade`: messages are only ever soft-deleted
  /// (`deletedAt`), never hard-deleted, so this only matters for a future
  /// hard-delete/cleanup job — a reply must never be blocked or removed
  /// just because the message it quotes was hard-deleted.
  replyToMessageId String?     @map("reply_to_message_id")
  replyTo   ChatMessage?       @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies   ChatMessage[]      @relation("MessageReplies")
  room      ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@unique([senderId, clientMessageId])
  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  // Serve the reconnect-replay query (undelivered messages addressed to a user).
  @@index([roomId, status])
  // Serves chat history paging. EXPLAIN showed the planner scanning the GLOBAL
  // `created_at` index backward with `room_id` as a mere Filter — i.e. walking
  // the newest messages of the whole table and discarding other rooms' until it
  // collected a page. That is fine with a handful of rooms and quadratic-ish in
  // practice as rooms multiply. Leading with roomId makes it an Index Cond and
  // the createdAt column keeps the page ordered, so a 30-message page reads 30
  // rows.
  @@index([roomId, createdAt])
  @@index([replyToMessageId])
  @@map("chat_messages")
}

/// Emoji reactions on a chat message.
model MessageReaction {
  id        String      @id @default(uuid())
  messageId String      @map("message_id")
  userId    String      @map("user_id")
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

/// Document verification, submit-then-admin-review workflow (PENDING ->
/// APPROVED/REJECTED). Originally scoped to government ID documents
/// (Aadhaar, PAN, Passport, Voter ID, Driving Licence) — deliberately
/// reused, not duplicated, for Income/Asset/NRI proof (see KycDocType)
/// because the workflow is identical: a document + reference number/image,
/// reviewed once by an admin into the same PENDING/APPROVED/REJECTED
/// lifecycle. A separate table per proof category would just be this same
/// shape three more times. Known friction from that reuse: `docNumber` is
/// NOT NULL, which fits every identity doc (Aadhaar/PAN number, passport
/// number) but has no natural equivalent for some income/asset proof
/// documents (e.g. a salary slip) — revisit (likely: make it nullable) once
/// an actual income/asset verification submission flow is built. Today
/// nothing in the codebase creates a row for any of these 8 doc types yet
/// (VerificationService/Controller and AdminVerificationService/Controller
/// are still empty stubs) — see ProfileCompletionService, which reads this
/// table for its verification scoring and correctly nets 0% for all of them
/// until that submission/approval flow exists.
model KycVerification {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  docType         KycDocType         @map("doc_type")
  /// Stored encrypted — never log or expose in plaintext
  docNumber       String             @map("doc_number")
  s3DocKey        String             @map("s3_doc_key")
  status          VerificationStatus @default(PENDING)
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_verifications")
}

/// Current face-verification state — exactly one row per user. The history of
/// how it got here lives in FaceVerificationAttempt.
///
/// A stored `status = VERIFIED` is necessary but NOT sufficient for the
/// "Face Verified" badge. The badge is derived at read time
/// (verification/domain/face-verification-state.ts): the photo the live selfie
/// was matched against (`matchedPhotoId` + `matchedPhotoS3Key`) must still
/// exist, still hold the same object, and still be the member's primary photo.
/// Replacing that photo changes its s3Key, deleting it nulls matchedPhotoId,
/// and promoting another photo moves isPrimary — each silently ends the badge
/// without PhotoService having to know face verification exists.
model FaceVerification {
  id                String                    @id @default(uuid())
  userId            String                    @unique @map("user_id")
  /// Legacy column from the original KYC-selfie design. Nullable: the liveness
  /// flow deliberately stores no selfie/reference image (no biometric storage
  /// in phase 1). Still collected by AccountDeletionService if ever set.
  selfieS3Key       String?                   @map("selfie_s3_key")
  status            FaceVerificationStatus    @default(UNVERIFIED)
  provider          FaceVerificationProvider?
  /// Mirrors `status == VERIFIED` for older readers; never the source of truth.
  isVerified        Boolean                   @default(false) @map("is_verified")
  /// Liveness confidence (0-100) of the attempt that produced the verification.
  confidenceScore   Decimal?                  @map("confidence_score") @db.Decimal(5, 2)
  /// CompareFaces similarity (0-100) of that same attempt.
  matchSimilarity   Decimal?                  @map("match_similarity") @db.Decimal(5, 2)
  matchedPhotoId    String?                   @map("matched_photo_id")
  matchedPhotoS3Key String?                   @map("matched_photo_s3_key")
  latestAttemptId   String?                   @unique @map("latest_attempt_id")
  verifiedAt        DateTime?                 @map("verified_at")
  /// Explicit (e.g. moderation) revocation. Photo changes do not set this —
  /// they invalidate by derivation, see the model comment.
  revokedAt         DateTime?                 @map("revoked_at")
  revocationReason  String?                   @map("revocation_reason")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchedPhoto      ProfilePhoto?             @relation("FaceVerificationMatchedPhoto", fields: [matchedPhotoId], references: [id], onDelete: SetNull)
  latestAttempt     FaceVerificationAttempt?  @relation("FaceVerificationLatestAttempt", fields: [latestAttemptId], references: [id], onDelete: SetNull)

  @@index([matchedPhotoId])
  @@map("face_verifications")
}

/// One Face Liveness + CompareFaces attempt. Append-only history used for the
/// per-user and global attempt caps, idempotent completion, and audit.
///
/// Stores scores and outcomes only — never the liveness reference image or
/// any other biometric artefact. `comparedPhotoId`/`comparedPhotoS3Key` pin
/// the exact primary photo the attempt was started against, so completion
/// compares against that photo and nothing else.
model FaceVerificationAttempt {
  id                  String                   @id @default(uuid())
  userId              String                   @map("user_id")
  provider            FaceVerificationProvider @default(AWS_REKOGNITION)
  /// AWS Face Liveness session id. Null until the session is created (and
  /// forever, if creation failed — such attempts do not count toward caps).
  livenessSessionId   String?                  @unique @map("liveness_session_id")
  /// Raw AWS session status (CREATED/IN_PROGRESS/SUCCEEDED/FAILED/EXPIRED).
  livenessStatus      String?                  @map("liveness_status")
  livenessConfidence  Decimal?                 @map("liveness_confidence") @db.Decimal(5, 2)
  comparedPhotoId     String?                  @map("compared_photo_id")
  comparedPhotoS3Key  String?                  @map("compared_photo_s3_key")
  matchSimilarity     Decimal?                 @map("match_similarity") @db.Decimal(5, 2)
  /// Faces CompareFaces detected in the profile photo. Must be exactly 1.
  targetFaceCount     Int?                     @map("target_face_count")
  /// Thresholds in force when the attempt was decided — kept so a later
  /// config change never makes an old decision unexplainable.
  livenessThreshold   Decimal                  @map("liveness_threshold") @db.Decimal(5, 2)
  similarityThreshold Decimal                  @map("similarity_threshold") @db.Decimal(5, 2)
  outcome             FaceVerificationOutcome  @default(PENDING)
  /// Internal diagnostic (e.g. an AWS error name). Never returned to clients.
  failureReason       String?                  @map("failure_reason")
  /// What the device reported. Recorded for audit, never used to decide.
  clientOutcome       String?                  @map("client_outcome")
  clientErrorCode     String?                  @map("client_error_code")
  consentAt           DateTime                 @map("consent_at")
  /// AWS discards a liveness session 3 minutes after creation; after this
  /// instant the attempt can only end as EXPIRED.
  expiresAt           DateTime                 @map("expires_at")
  processingStartedAt DateTime?                @map("processing_started_at")
  completedAt         DateTime?                @map("completed_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comparedPhoto       ProfilePhoto?            @relation("FaceVerificationAttemptComparedPhoto", fields: [comparedPhotoId], references: [id], onDelete: SetNull)
  latestFor           FaceVerification?        @relation("FaceVerificationLatestAttempt")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([outcome, expiresAt])
  @@index([comparedPhotoId])
  @@map("face_verification_attempts")
}

/// Audit trail for trust score changes (reasons: KYC, face verify, report, etc.).
model TrustScoreLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
