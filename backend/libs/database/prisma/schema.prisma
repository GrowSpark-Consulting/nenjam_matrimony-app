// ─────────────────────────── Location master data ───────────────────────────
//
// Country -> Subdivision -> City, keyed by ISO 3166 codes. Populated once by
// `pnpm seed:locations` from the files in seed-data/, which were built by hand
// from GeoNames; nothing here is fetched at runtime.
//
// The natural key IS the ISO code, not a surrogate uuid. A code is already
// unique, stable and meaningful, so profiles store `IN-TN-CHENNAI` directly and
// the API never has to expose an internal database id to the client.
//
// `isActive` is what registration dropdowns filter on. Deactivating is how a
// row is retired — rows are never deleted, because a profile may still
// reference one (India's pre-2020 IN-DD / IN-DN are the worked example).
// See seed-data/README.md for every deliberate deviation from the ISO source.

/// ISO 3166-1 country.
model Country {
  code      String        @id @db.VarChar(2)
  label     String
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  states    Subdivision[]
  cities    City[]
  profiles  UserProfile[]

  @@index([isActive])
  @@map("countries")
}

/// ISO 3166-2 subdivision — a state, province, territory or region.
model Subdivision {
  code        String        @id @db.VarChar(6)
  countryCode String        @map("country_code") @db.VarChar(2)
  label       String
  /// ISO's own wording for what this is ("State", "Union territory",
  /// "Province"). Shown in the UI to disambiguate same-named entries.
  type        String
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  country     Country       @relation(fields: [countryCode], references: [code])
  cities      City[]
  profiles    UserProfile[]

  // Serves the states-for-a-country dropdown, which is always
  // "this country, active only, ordered by label".
  @@index([countryCode, isActive, label])
  @@map("subdivisions")
}

/// City, keyed as `{subdivision code}-{normalized name}` e.g. IN-TN-CHENNAI.
model City {
  code        String        @id @db.VarChar(80)
  stateCode   String        @map("state_code") @db.VarChar(6)
  /// Denormalized from the parent subdivision. Worth the redundancy: it lets
  /// a country-wide city search skip the join, and the FK below still stops
  /// it drifting out of step with the subdivision's own country.
  countryCode String        @map("country_code") @db.VarChar(2)
  label       String
  /// Drives dropdown ordering — members expect their large city near the top,
  /// not buried alphabetically.
  population  Int
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  state       Subdivision   @relation(fields: [stateCode], references: [code])
  country     Country       @relation(fields: [countryCode], references: [code])
  profiles    UserProfile[]

  // Serves the cities-for-a-state dropdown: largest first, then alphabetical.
  @@index([stateCode, isActive, population(sort: Desc)])
  // Serves type-ahead search across a whole country.
  @@index([countryCode, isActive])
  @@index([label])
  @@map("cities")
}

