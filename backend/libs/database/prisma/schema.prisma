/// Delivery record for every transactional/lifecycle email the platform sends.
///
/// Written by the worker, never by the API: the API only enqueues. One row per
/// send attempt outcome, updated in place as BullMQ retries, so `attempts`
/// reflects the true number of provider calls rather than the number of rows.
///
/// `provider` and `template` are plain strings on purpose — adding an
/// AwsSesProvider or a new template must not require a schema migration.
model EmailLog {
  id                String      @id @default(uuid())
  /// Nullable: verification and password-reset mail can precede a User row,
  /// and account deletion nulls this out rather than destroying the audit trail.
  userId            String?     @map("user_id")
  recipient         String
  subject           String
  /// Template identifier, e.g. "otp" / "welcome" — matches the .hbs filename.
  template          String
  /// Provider identifier, e.g. "resend" / "ses" / "noop".
  provider          String
  status            EmailStatus @default(QUEUED)
  /// Provider-side id, used to correlate with their dashboard/webhooks.
  providerMessageId String?     @map("provider_message_id")
  attempts          Int         @default(0)
  /// Non-PII job context (jobId, emailType, durationMs, ...). Never the payload.
  metadata          Json?
  /// Last failure reason. Provider errors only — never credentials.
  error             String?
  sentAt            DateTime?   @map("sent_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([recipient])
  @@index([createdAt])
  /// Serves the "recent failures" ops view (WHERE status ORDER BY created_at DESC).
  @@index([status, createdAt])
  @@map("email_logs")
}

/// Lifecycle of a single email send.
enum EmailStatus {
  /// Job accepted onto the queue, not yet attempted.
  QUEUED
  /// Provider accepted it.
  SENT
  /// Attempt failed; BullMQ may still retry.
  FAILED
  /// All retries exhausted — moved to the dead-letter queue for manual replay.
  DEAD_LETTER

  @@map("email_status")
}

/// Per-user app preferences: theme, push opt-in, UI language.
///
/// Modelled from the live table rather than the other way round. The
/// `20260724120000_add_user_settings` migration was applied to the shared
/// database from a developer machine but its folder was never committed, so
/// schema.prisma and the database had diverged — every `prisma migrate dev`
/// demanded a full reset. The migration has since been reconstructed from the
/// live DDL and this model added to close the gap.
///
/// Distinct from the two privacy flags on User (profileVisibleToPremiumOnly /
/// hidePhotosFromNonConnections), which are matching-visibility rules rather
/// than client preferences. No API reads this yet — the Flutter app currently
/// keeps theme in local storage.
model UserSettings {
  id                       String    @id @default(uuid())
  userId                   String    @unique @map("user_id")
  theme                    ThemeMode @default(SYSTEM)
  pushNotificationsEnabled Boolean   @default(true) @map("push_notifications_enabled")
  language                 String    @default("en")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Client theme preference. SYSTEM follows the OS setting.
enum ThemeMode {
  LIGHT
  DARK
  SYSTEM

  @@map("theme_mode")
}

// ─────────────────────── Religion / community master data ───────────────────
//
// Religion -> Community, the same shape as the location tables above and
// populated the same way: `pnpm seed:religions` reads seed-data/religions.json,
// which was migrated verbatim from the lists the Flutter app already shipped.
//
// NOTE ON NAMING: these deliberately mirror the columns that already exist on
// user_profiles (`religion`, `community`) rather than introducing a "caste"
// vocabulary. The app uses all three words inconsistently today — 'Iyer' is a
// community in ProfileOptions, a caste in the profile seeder and a
// sub-community in ProfileOptions.subCommunities — so renaming anything here
// would have to pick a winner and migrate live profile data to match. Nothing
// is renamed; these tables simply back the fields that already exist.
//
// There is deliberately no SubCommunity table. No community -> sub-community
// relationship exists anywhere in the project, and inventing one is not an
// option, so that field stays free text until a sourced dataset is supplied.

/// A religion offered in registration and search.
model Religion {
  code        String      @id @db.VarChar(20)
  label       String
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  communities Community[]

  @@index([isActive])
  @@map("religions")
}

/// A community within a religion, keyed as `{religion code}-{normalized name}`
/// e.g. HINDU-VELLALAR — deterministic, so a reseed reproduces the same code.
model Community {
  code         String   @id @db.VarChar(60)
  religionCode String   @map("religion_code") @db.VarChar(20)
  label        String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  religion     Religion @relation(fields: [religionCode], references: [code])

  // Serves the communities-for-a-religion dropdown: this religion, active
  // only, ordered by label — the one query the endpoint issues.
  @@index([religionCode, isActive, label])
  @@map("communities")
}

// ============================================================================
// Agent / Partner Program — phase 1.
// These tables may point at existing ones (User, DevicePlatform); no existing
// model points at them except the single User.referralAttribution
// back-relation, which adds no column. Constraints Prisma cannot express live
// only in the migration SQL: the referral code format CHECK, the
// one-primary-code-per-agent partial unique index, a REJECTED agent must have a
// non-blank rejection_reason, and pan_verified_at needs pan_encrypted.
// ============================================================================

/// Lifecycle of an agent's account. SUSPENDED is shown to the agent as "Paused".
enum AgentStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  TERMINATED

  @@map("agent_status")
}

/// How a member came to be attributed to an agent.
enum ReferralSource {
  CODE_AT_SIGNUP
  LINK_OR_QR
  ADDED_BY_AGENT
  ENTERED_AT_PAYMENT
  ADMIN_SET

  @@map("referral_source")
}

/// Whether an attribution still counts.
enum AttributionStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  REJECTED

  @@map("attribution_status")
}

/// A partner who refers members. A separate identity from User by design: no
/// userId, signs in with their own phone + OTP and agent token.
model Agent {
  id               String      @id @default(uuid())
  /// E.164, e.g. +919876543210.
  phone            String      @unique
  /// "v1:"-prefixed keyed hash of the phone (the shared identifier hasher). Used for lookup.
  phoneHash        String      @unique @map("phone_hash")
  name             String
  city             String
  state            String
  /// Last 4 characters of the PAN, the only part kept in clear.
  panLast4         String?     @map("pan_last4") @db.VarChar(4)
  /// The full PAN sealed by AgentSecretSealer (AES-256-GCM, "v1:" prefix). Never returned to clients. Null until supplied.
  panEncrypted     String?     @map("pan_encrypted")
  /// When staff verified the PAN (payout eligibility needs it before the first payout). Null until verified; cleared when the PAN is replaced.
  panVerifiedAt    DateTime?   @map("pan_verified_at")
  /// True once the agent has payout details (agent_payout_details); kept in step by the service in the same transaction.
  payoutDetailsSet Boolean     @default(false) @map("payout_details_set")
  status           AgentStatus @default(PENDING_APPROVAL)
  /// Set when status = REJECTED; shown to the applicant.
  rejectionReason  String?     @map("rejection_reason")
  approvedAt       DateTime?   @map("approved_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  referralCodes ReferralCode[]
  attributions  ReferralAttribution[]
  refreshTokens AgentRefreshToken[]
  deviceTokens  AgentDeviceToken[]
  payoutDetails AgentPayoutDetails?

  /// Overrides the active commission policy for this agent. Null = use the active one.
  commissionPolicyId String?                  @map("commission_policy_id")
  commissionPolicy   CommissionPolicyVersion? @relation(fields: [commissionPolicyId], references: [id], onDelete: Restrict)
  commissions        Commission[]
  ledgerEntries      AgentLedgerEntry[]
  payouts            AgentPayout[]

  @@index([status])
  @@map("agents")
}

/// An "NM" + 6 character code an agent shares. An agent may hold several but
/// only one is primary (partial unique index in the migration SQL).
model ReferralCode {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  /// NM + 6 chars from 23456789ABCDEFGHJKMNPQRSTUVWXYZ (CHECK in the migration SQL).
  code      String   @unique @db.VarChar(8)
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent        Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]

  @@index([agentId])
  @@map("referral_codes")
}

/// Which agent a member is credited to. Keyed on the phone HASH so it can exist
/// before the person registers and survives account deletion. One per phone.
model ReferralAttribution {
  id           String            @id @default(uuid())
  /// Null until the person signs up and is matched by phoneHash.
  userId       String?           @unique @map("user_id")
  /// "v1:"-prefixed keyed hash of the phone. REQUIRED: a member with no verified
  /// phone cannot be credited. One attribution per phone, ever.
  phoneHash    String            @unique @map("phone_hash")
  agentId      String            @map("agent_id")
  /// The code used, when there was one.
  codeId       String?           @map("code_id")
  source       ReferralSource
  status       AttributionStatus @default(ACTIVE)
  /// End of the credit window, snapshotted from the setting when created.
  windowEndsAt DateTime          @map("window_ends_at")
  /// Accepted without a verified phone; an admin should look at it.
  needsReview  Boolean           @default(false) @map("needs_review")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  agent Agent         @relation(fields: [agentId], references: [id])
  code  ReferralCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  /// SetNull: deleting a member must not delete the attribution (it carries
  /// commission history).
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  commission Commission?

  @@index([agentId, createdAt])
  @@index([codeId])
  @@index([status, windowEndsAt])
  @@map("referral_attributions")
}

/// Rotating refresh tokens for the agent's own session (not Firebase). Only a
/// keyed hash is stored. Presenting a revoked token again revokes EVERY token
/// of the agent, so no per-login family is needed.
model AgentRefreshToken {
  id        String    @id @default(uuid())
  agentId   String    @map("agent_id")
  /// HMAC-SHA256 of the opaque token with a server pepper; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set on rotation, logout, or reuse detection.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@map("agent_refresh_tokens")
}

/// FCM tokens for push to the agent app. Mirrors DevicePushToken, keyed on Agent.
model AgentDeviceToken {
  id        String         @id @default(uuid())
  agentId   String         @map("agent_id")
  fcmToken  String         @unique @map("fcm_token")
  platform  DevicePlatform
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_device_tokens")
}

enum AgentPayoutMethod {
  UPI
  BANK

  @@map("agent_payout_method")
}

/// Where an admin-created payout goes. At most one row per agent. The details
/// are sealed; only the masked `display` is ever shown.
model AgentPayoutDetails {
  agentId       String            @id @map("agent_id")
  method        AgentPayoutMethod
  /// The UPI id or bank account, sealed by AgentSecretSealer. Never returned.
  detailsSealed String            @map("details_sealed")
  /// Masked text safe to show, e.g. "r***@okbank" or "HDFC ****9012".
  display       String
  /// Null until an admin verifies the details; cleared on every change.
  verifiedAt    DateTime?         @map("verified_at")
  /// When the details last changed; the payout wait counts from here.
  changedAt     DateTime          @map("changed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_payout_details")
}

/// The phone an applicant verified at sign-in, kept (sealed) until they apply,
/// so the application never takes the phone from the request body. Written at
/// verify time, deleted after a successful application; expired rows are purged.
model AgentApplicant {
  /// "v1:"-prefixed keyed hash of the verified phone.
  phoneHash   String   @id @map("phone_hash")
  /// The verified E.164 phone, sealed by AgentSecretSealer.
  phoneSealed String   @map("phone_sealed")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("agent_applicants")
}

/// Attempt counters for the referral-code check and attach (guessing codes).
/// Rows older than the configured window mean nothing and should be purged.
/// requesterKey is OPAQUE (a keyed hash of the IP, or a namespaced member id),
/// never a raw IP address.
model ReferralCodeAttempt {
  id           String   @id @default(uuid())
  requesterKey String   @map("requester_key")
  /// Null for text that is not a well-formed code.
  codeKey      String?  @map("code_key")
  attemptedAt  DateTime @default(now()) @map("attempted_at")

  @@index([requesterKey, attemptedAt])
  @@index([codeKey, attemptedAt])
  @@index([attemptedAt])
  @@map("referral_code_attempts")
}

// ---------------------------------------------------------------------------
// Agent commissions, ledger and payouts (migration 20261029110000).
// Money is integer PAISE. Nothing here cascades on delete: a money record can
// only be removed by deleting it deliberately, never as a side effect.
// ---------------------------------------------------------------------------

enum CommissionCalcType {
  PERCENTAGE

  @@map("commission_calc_type")
}

/// The internal commission status (what staff see). The agent sees a reduced set.
enum CommissionStatus {
  ON_HOLD
  AWAITING_VERIFICATION
  IN_REVIEW
  FROZEN
  READY
  APPROVED
  PAID
  CANCELLED
  REVERSED

  @@map("commission_status")
}

enum AgentLedgerEntryType {
  CREDIT
  REVERSAL
  PAYOUT_DEBIT
  PAYOUT_RELEASE
  ADJUSTMENT

  @@map("agent_ledger_entry_type")
}

enum AgentPayoutStatus {
  CREATED
  PAID
  CANCELLED

  @@map("agent_payout_status")
}

/// One version of the commission rule. Versions are added, not edited: a
/// commission snapshots the rule it was calculated with. The active version is
/// the newest one whose effective_from has passed.
model CommissionPolicyVersion {
  id            String             @id @default(uuid())
  /// 1, 2, 3 ... one row per number.
  version       Int                @unique
  calcType      CommissionCalcType @map("calc_type")
  /// Basis points for PERCENTAGE (1000 = 10%).
  value         Int
  /// Days a commission waits before it can be approved.
  holdDays      Int                @map("hold_days")
  effectiveFrom DateTime           @map("effective_from")
  createdAt     DateTime           @default(now()) @map("created_at")

  agents      Agent[]
  commissions Commission[]

  @@index([effectiveFrom])
  @@map("commission_policy_versions")
}

/// What an agent earns on one member's first paid plan. One per attribution,
/// one per payment and one per member phone hash.
model Commission {
  id                 String             @id @default(uuid())
  agentId            String             @map("agent_id")
  attributionId      String             @unique @map("attribution_id")
  /// payment_transactions.id. A plain id (no foreign key), like the payment events.
  paymentId          String             @unique @map("payment_id")
  /// Hash of the referred member's phone; one commission per phone, ever.
  phoneHash          String             @unique @map("phone_hash")
  policyVersionId    String             @map("policy_version_id")
  status             CommissionStatus   @default(ON_HOLD)
  /// The rule this commission was calculated with, snapshotted.
  calcType           CommissionCalcType @map("calc_type")
  ruleValue          Int                @map("rule_value")
  /// What the percentage was taken of (excluding GST); null while commission.base is not set.
  basePaise          Int?               @map("base_paise")
  /// Null until the base is known.
  amountPaise        Int?               @map("amount_paise")
  /// What the member actually paid for the plan.
  amountPaidPaise    Int                @map("amount_paid_paise")
  /// The part of amount_paid_paise without GST, as stored on the payment (never recomputed). Kept so the amount can be filled in later if commission.base was not set when the payment came in.
  taxableAmountPaise Int                @map("taxable_amount_paise")
  /// The running total refunded BEFORE approval (a partial refund reduces the commission in proportion; nothing was credited yet). After approval, refunds go through the ledger (reversed_paise).
  refundedPaise      Int                @default(0) @map("refunded_paise")
  /// The amount before a refund reduced it; the reference for later refunds. Null until a refund reduced it (or while the amount is unknown).
  preRefundAmountPaise Int?             @map("pre_refund_amount_paise")
  /// What has been credited to the agent's ledger for this commission.
  creditedPaise      Int                @default(0) @map("credited_paise")
  /// What refunds have clawed back so far.
  reversedPaise      Int                @default(0) @map("reversed_paise")
  holdUntil          DateTime           @map("hold_until")
  /// PAID_BY_AGENT, PAYMENT_SOURCE_REUSED, SELF_MATCH: why it is IN_REVIEW.
  reviewReasons      String[]           @default([]) @map("review_reasons")
  approvedAt         DateTime?          @map("approved_at")
  paidAt             DateTime?          @map("paid_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  payoutId           String?            @map("payout_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  agent         Agent                   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  attribution   ReferralAttribution     @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  policyVersion CommissionPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  payout        AgentPayout?            @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ledgerEntries AgentLedgerEntry[]

  @@index([agentId, status])
  @@index([status, holdUntil])
  @@index([payoutId])
  @@map("commissions")
}

/// The agent's money, one signed row per movement. APPEND-ONLY: a trigger in
/// the migration rejects UPDATE and DELETE. The balance is the sum of amounts.
model AgentLedgerEntry {
  id             String               @id @default(uuid())
  agentId        String               @map("agent_id")
  type           AgentLedgerEntryType
  /// Signed: + adds to the agent's balance, - takes from it. Never 0.
  amountPaise    Int                  @map("amount_paise")
  /// Replaying the same event writes nothing twice.
  idempotencyKey String               @unique @map("idempotency_key")
  commissionId   String?              @map("commission_id")
  /// The provider's refund id, on REVERSAL entries.
  refundId       String?              @map("refund_id")
  payoutId       String?              @map("payout_id")
  /// The commission rule snapshotted on CREDIT entries.
  calcType       String?              @map("calc_type")
  ruleValue      Int?                 @map("rule_value")
  ruleSnapshot   Json?                @map("rule_snapshot")
  /// Required on ADJUSTMENT entries.
  reason         String?
  createdAt      DateTime             @default(now()) @map("created_at")

  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  payout     AgentPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([agentId, createdAt])
  @@index([commissionId])
  @@index([payoutId])
  @@map("agent_ledger_entries")
}

/// A manual payout for one agent and one calendar month.
model AgentPayout {
  id               String            @id @default(uuid())
  agentId          String            @map("agent_id")
  /// 'YYYY-MM'. At most one non-cancelled payout per agent and period (partial unique index in the migration SQL).
  period           String
  amountPaise      Int               @map("amount_paise")
  taxWithheldPaise Int               @default(0) @map("tax_withheld_paise")
  netPaise         Int               @map("net_paise")
  status           AgentPayoutStatus @default(CREATED)
  /// The bank or UPI reference once paid; unique when set.
  reference        String?           @unique
  paidAt           DateTime?         @map("paid_at")
  cancelReason     String?           @map("cancel_reason")
  cancelledAt      DateTime?         @map("cancelled_at")
  /// The staff user id who created it. A plain id (no foreign key), like audit rows.
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  agent         Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  commissions   Commission[]
  ledgerEntries AgentLedgerEntry[]

  @@index([agentId, period])
  @@index([status])
  @@map("agent_payouts")
}
