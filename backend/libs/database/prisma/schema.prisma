/// Immutable audit log for all sensitive admin and system actions.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  /// STAFF | MEMBER | AGENT | SYSTEM — actorId alone can't say, because
  /// agents are not users. Null on rows written before this column existed.
  actorType String?  @map("actor_type")
  /// Why the actor did it — required for sensitive admin changes.
  reason    String?
  before    Json?
  after     Json?
  requestId String?  @map("request_id")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Values operators tune without a release: agent-program rules, rates and
/// limits. Keys are added by migration only; admins change values through
/// `PUT /admin/settings/:key` (audited, versioned). `value` is stored JSON and
/// is validated by the code that reads it, never here — JSON `null` is a real
/// value ("not decided"), distinct from a missing key.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  /// Starts at 1, +1 on every change; an update names the version it read.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// One-time codes for phone sign-in outside Firebase (agents). Bound to a
/// purpose: a challenge never verifies for another one. The code is stored
/// hashed; a challenge verifies once, dies after the attempt limit, and
/// expires. Expired rows are purged in small batches when codes are sent.
model OtpChallenge {
  id         String     @id @default(uuid())
  purpose    OtpPurpose
  phoneE164  String     @map("phone_e164")
  codeHash   String     @map("code_hash")
  /// Every verify call counts, the right code included.
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([purpose, phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

