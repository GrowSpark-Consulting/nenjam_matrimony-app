<h1 class="nm-h1" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:600;color:#1B2B4B;">
  Security alert
</h1>
<p style="margin:0 0 20px;">
  {{eventDescription}} If this was you, no action is needed.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="border:1px solid #E8EDF5;border-radius:10px;margin:0 0 20px;">
  <tr><td style="padding:18px 22px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">When</td>
        <td align="right" style="font-size:14px;color:#1A1C20;padding:3px 0;">{{occurredAt}}</td>
      </tr>
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Device</td>
        <td align="right" style="font-size:14px;color:#1A1C20;padding:3px 0;">{{device}}</td>
      </tr>
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Location</td>
        <td align="right" style="font-size:14px;color:#1A1C20;padding:3px 0;">{{location}}</td>
      </tr>
    </table>
  </td></tr>
</table>
<p style="margin:0 0 8px;font-weight:600;color:#1B2B4B;">If this wasn't you</p>
<p style="margin:0 0 20px;color:#4B5563;">
  Secure your account now — this signs out every other device.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="nm-cta" style="margin:0 0 8px;">
  <tr><td align="center" bgcolor="#1B2B4B" style="border-radius:8px;">
    <a href="{{appUrl}}/settings/security" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;">Secure my account</a>
  </td></tr>
</table>
