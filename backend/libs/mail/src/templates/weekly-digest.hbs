<h1 class="nm-h1" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:600;color:#1B2B4B;">
  {{matchCount}} new {{plural matchCount "match" "matches"}} this week
</h1>
<p style="margin:0 0 22px;">
  Here's who caught our eye for you, {{firstName}}.
</p>
{{#each matches}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="border:1px solid #E8EDF5;border-radius:10px;margin:0 0 12px;">
  <tr><td style="padding:16px 20px;">
    <p style="margin:0 0 3px;font-size:17px;font-weight:600;color:#1B2B4B;">{{this.name}}</p>
    <p style="margin:0 0 10px;font-size:14px;color:#6B7280;">{{this.age}} &middot; {{this.city}}</p>
    <a href="{{this.profileUrl}}" style="font-size:14px;font-weight:600;color:#1B2B4B;">View profile &rarr;</a>
  </td></tr>
</table>
{{else}}
<p style="margin:0 0 20px;color:#6B7280;">
  No new matches this week. Widening your partner preferences usually surfaces more people.
</p>
{{/each}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="nm-cta" style="margin:22px 0 8px;">
  <tr><td align="center" bgcolor="#1B2B4B" style="border-radius:8px;">
    <a href="{{appUrl}}/discover" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;">See all matches</a>
  </td></tr>
</table>
