<h1 class="nm-h1" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:600;color:#1B2B4B;">
  {{planName}} is active
</h1>
<p style="margin:0 0 20px;">
  Payment received, {{firstName}} — your plan is live and everything below is unlocked.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="border:1px solid #E2CC7E;background-color:#FAF5E4;border-radius:12px;margin:0 0 20px;">
  <tr><td style="padding:20px 22px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Plan</td>
        <td align="right" style="font-size:14px;font-weight:600;color:#1B2B4B;padding:3px 0;">{{planName}}</td>
      </tr>
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Amount paid</td>
        <td align="right" style="font-size:14px;font-weight:600;color:#1B2B4B;padding:3px 0;">{{amount}}</td>
      </tr>
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Valid until</td>
        <td align="right" style="font-size:14px;font-weight:600;color:#1B2B4B;padding:3px 0;">{{validUntil}}</td>
      </tr>
      {{#if invoiceId}}
      <tr>
        <td style="font-size:14px;color:#6B7280;padding:3px 0;">Reference</td>
        <td align="right" style="font-size:13px;color:#6B7280;padding:3px 0;">{{invoiceId}}</td>
      </tr>
      {{/if}}
    </table>
  </td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="nm-cta" style="margin:0 0 8px;">
  <tr><td align="center" bgcolor="#1B2B4B" style="border-radius:8px;">
    <a href="{{appUrl}}/discover" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;">Start browsing</a>
  </td></tr>
</table>
