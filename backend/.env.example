# ===================================================================
# Nenjam Matrimony — backend environment TEMPLATE
# ===================================================================
# This file is COMMITTED and must only ever contain placeholder values.
# It is the single tracked exception to the .env* ignore rules — see
# .gitignore. Never paste a real password, key, token or connection
# string into this file.
#
# Setup:
#   cp .env.example .env      # then fill in real values
#
# Load order (libs/config/src/config.module.ts): ['.env.local', '.env'].
# .env is the normal per-developer file; .env.local overrides it
# per-variable when present. Both are gitignored. The Prisma CLI reads
# the same two files in the same order via prisma.config.ts.
#
# Validation: libs/config/src/validation.ts (Joi). The app fails fast at
# boot listing every invalid/missing variable at once.
# ===================================================================

# ---------- Runtime ----------
# NODE_ENV drives more than logging: ElasticsearchService only tolerates
# an unreachable cluster when this is "development" — in production a
# failed Elasticsearch ping aborts startup.
# One of: development | production | test | staging   (default: development)
NODE_ENV=development
# HTTP port for the API app.                          (default: 3000)
PORT=3000
# Port for the standalone websocket app (apps/websocket). (default: 3001)
WEBSOCKET_PORT=3001
# One of: error | warn | info | debug | verbose        (default: info)
LOG_LEVEL=debug

# ---------- Database (PostgreSQL / Neon) ----------
# Choose ONE of the two options below.
#
# (A) Managed/shared Postgres (e.g. Neon) — set DATABASE_URL only. It is
#     used verbatim by both the app and the Prisma CLI and carries its own
#     SSL mode. This takes precedence over the discrete fields in (B).
DATABASE_URL="postgresql://username:password@host.region.aws.neon.tech/database?sslmode=require"
#
# (B) Local Postgres — leave DATABASE_URL empty and fill these in instead.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=nenjam_matrimony

# ---------- Redis ----------
# Choose ONE of the two options below.
#
# (A) Managed Redis (e.g. Redis Cloud) — set REDIS_URL only. Use redis://
#     or rediss:// (ioredis auto-detects TLS from the scheme). Takes
#     precedence over the discrete fields in (B).
REDIS_URL=redis://username:password@host.redis.io:6379
#
# (B) Local Redis / Memurai — leave REDIS_URL empty and fill these in.
#     A blank value is treated as absent, not as a validation error.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=

# ---------- Elasticsearch ----------
# REQUIRED and must be a valid URI, even if no cluster is running:
# validation rejects a missing/blank value. In development an unreachable
# cluster only logs a warning and search falls back to the Postgres
# strategy; in production it aborts startup.
ELASTICSEARCH_NODE=https://localhost:9200
# Index name. Currently unused by application code — kept for parity with
# deployment configs. Safe to leave at the default.
ELASTICSEARCH_INDEX=profiles
# Basic Auth for a secured cluster. Leave both blank to connect without auth.
ELASTICSEARCH_USERNAME=your_elasticsearch_username
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# ---------- SMTP (transactional email) ----------
# REQUIRED (host + port). For local development point these at a mail
# catcher such as MailHog/Mailpit on 127.0.0.1:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ---------- JWT ----------
# REQUIRED, minimum 16 characters. Use a long random value and a DIFFERENT
# one per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_min_16_chars

# ---------- Agent program (optional) ----------
# AGENT_PROGRAM_ENABLED: the agent-facing routes (/agent/*) and the member
# referral routes (/referrals/codes/validate, /registration/referral-code)
# exist only when this is exactly `true`; otherwise they answer 404. Set it
# LAST, after the secrets below (see docs/agent-program for the order). The
# checkout's referral quote and the commission handlers do not depend on it.
# AGENT_PROGRAM_ENABLED=false
#
# AGENT_JWT_SECRET: signs Agent Portal access tokens (HS256) and keys the
# stored refresh-token hashes. At least 32 random characters, DIFFERENT from
# JWT_SECRET. Missing or shorter with the flag on: the agent routes answer
# 503 and startup logs a warning (the API still starts). Changing it signs
# every agent out. Never commit a real value.
# AGENT_JWT_SECRET=
#
# AGENT_PII_ENCRYPTION_KEY: seals agent PAN, payout details and applicant
# phones. 32 random bytes, base64 (44 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Missing with the flag on: sign-in, application and payout details answer
# 503 (warning at startup). Malformed: the API refuses to start. Never
# change it once data is sealed with it. Never commit a real value.
# AGENT_PII_ENCRYPTION_KEY=

# ---------- CORS ----------
# Optional. Comma-separated list of origins allowed to call the API
# cross-origin (the deployed web frontend's domain(s)), e.g.:
#   CORS_ORIGINS=https://app.your-domain.com,https://your-domain.com
# Left unset: development reflects the request origin (today's behavior);
# production/staging reject all cross-origin requests until this is set.
CORS_ORIGINS=

# ---------- Firebase Admin SDK ----------
# Optional: the app boots without these, but every endpoint behind
# FirebaseAuthGuard returns 500 until they are set. Values come from the
# service-account JSON in Firebase Console > Project settings > Service accounts.
#
# FIREBASE_PRIVATE_KEY must stay double-quoted and keep its literal \n
# escape sequences — configuration.ts converts them to real newlines before
# handing the key to cert(). Paste the private_key field verbatim.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ---------- AWS S3 (profile photos + verification documents) ----------
# Optional: the app boots without these; only the photo/document upload
# endpoints need them, and S3Service returns a clear error if a request
# reaches it unconfigured. Prefer an IAM user scoped to just this bucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# ---------- Face verification (AWS Face Liveness + CompareFaces) ----------
# Off by default. With it off — or on but missing any AWS value below — the
# app boots normally and /verification/face/* answers 503 NOT_AVAILABLE.
#
# The key pair is for the DEDICATED face-verification backend IAM identity
# (planned: nenjam-face-verification-backend), NEVER the S3 credentials above.
# It needs rekognition:CreateFaceLivenessSession,
# rekognition:GetFaceLivenessSessionResults, rekognition:CompareFaces and
# sts:AssumeRole on the client role — no S3 permissions (the profile photo is
# read with the existing S3 credentials and sent to Rekognition as bytes).
#
# FACE_LIVENESS_CLIENT_ROLE_ARN is the role the backend assumes to mint the
# device's temporary, StartFaceLivenessSession-only credentials
# (planned: nenjam-face-liveness-client). Android never receives these keys.
FACE_VERIFICATION_ENABLED=false
FACE_VERIFICATION_AWS_REGION=ap-south-1
FACE_VERIFICATION_AWS_ACCESS_KEY_ID=
FACE_VERIFICATION_AWS_SECRET_ACCESS_KEY=
FACE_LIVENESS_CLIENT_ROLE_ARN=
# Device credential lifetime, seconds (900-3600).
FACE_LIVENESS_CREDENTIALS_TTL_SECONDS=900
# Decision thresholds (0-100). Tune on real data; stored per attempt.
FACE_LIVENESS_MIN_CONFIDENCE=90
FACE_MATCH_MIN_SIMILARITY=90
# Paid-attempt caps: per member per rolling 24h, and all members per UTC day.
FACE_VERIFICATION_MAX_ATTEMPTS_PER_DAY=3
FACE_VERIFICATION_GLOBAL_DAILY_CAP=500

# ---------- Email (Resend) ----------
# Optional. Left blank, the app boots and MailModule binds a no-op provider
# that queues, renders and logs an EmailLog row without calling out — so local
# dev and CI exercise the whole pipeline without a third-party secret.
# Format is still validated when present: it must look like "re_...".
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# "user@domain.com" or "Display Name <user@domain.com>".
# onboarding@resend.dev needs no domain verification but only delivers to the
# Resend account owner's own address — fine for development, not for real users.
MAIL_FROM=Nenjam Matrimony <onboarding@resend.dev>
# Optional Reply-To. Unset, replies go to MAIL_FROM.
MAIL_REPLY_TO=
# Shown in every template footer.
MAIL_SUPPORT_EMAIL=support@your-domain.com
# Absolute URL to the logo. Unset, templates fall back to a text wordmark.
MAIL_LOGO_URL=
# Base URL for the CTA buttons rendered into templates.
APP_WEB_URL=https://your-domain.com

# ---------- Discover-feed progressive fallback ----------
# Tunes how far ProgressiveFallbackStrategy widens a search that returns
# zero strict matches. All optional with sane defaults.
FALLBACK_ENABLED=true
AGE_RELAX_STEP_1=2
AGE_RELAX_STEP_2=5
MAX_FALLBACK_TIER=10

# ---------- Psychology (optional Discover ranking signal) ----------
# Psychology can never fail a Discover request: on any error, timeout or bad
# data the feed is ranked without it. PSYCHOLOGY_MATCHING_ENABLED=false is a
# kill switch (no psychology queries, scores identical to pre-psychology).
# PSYCHOLOGY_TIMEOUT_MS is the per-phase budget before Discover moves on.
PSYCHOLOGY_MATCHING_ENABLED=true
PSYCHOLOGY_TIMEOUT_MS=800
# Days a member must wait before changing their quiz answers again. The first
# submission, and a retake of answers made stale by a quiz update, are never
# delayed. 0 disables the limit. Slows anyone probing another member's answers
# by re-answering and watching how the feed reorders.
PSYCHOLOGY_RETAKE_COOLDOWN_DAYS=7

# ---------- Membership plans (Free / Gold / Platinum) ----------
# off     = no membership checks at all (pre-membership behaviour)
# shadow  = resolve plans and record usage, LOG anything that would be denied,
#           deny nothing. The default — safe while checkout isn't live.
# enforce = plan limits and paid features are enforced (403). Switch only once
#           members can actually buy a plan and the app handles the 403 body.
# See docs/membership/README.md.
MEMBERSHIP_ENFORCEMENT_MODE=shadow

# ---------- Razorpay (optional) ----------
# Leave blank and checkout + the webhook answer 503; the app still boots.
# Never commit real values — put them in .env.local / the host's env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Admin panel (optional) ----------
# Encrypts admins' authenticator secrets at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave blank and admin sign-in answers 503; the app still boots. One value per
# environment; changing it invalidates every enrolled authenticator.
ADMIN_MFA_ENCRYPTION_KEY=

# ---------- Daily jobs (optional) ----------
# POST /internal/jobs/daily runs the payment event catch-up and every feature's
# daily job (agent commission approval). A GitHub Actions schedule calls it with
# this value as the X-Jobs-Secret header: set the SAME value here (Render) and
# as the repository secret JOBS_SECRET. At least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Blank: the route answers 503 and the app still boots.
JOBS_SECRET=

# ---------- Identifier hashing (optional) ----------
# Keyed hashes of phones, emails, PANs and IPs (agent program). Newest first:
#   IDENTIFIER_HASH_PEPPERS=v1:<secret>[,v0:<older secret>]
# Each secret at least 32 characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Blank: the app boots and the agent program's routes answer 503. Never change
# or drop a pepper in use — add a new version in front instead.
IDENTIFIER_HASH_PEPPERS=

# ---------- Agent sign-in codes: dummy mode (TESTING ONLY) ----------
# No SMS provider yet, so agent sign-in codes only work in dummy mode: the
# code below is accepted instead of a sent one. Off unless exactly `true`.
# AGENT_OTP_DUMMY_PHONES limits it to these E.164 numbers (comma-separated);
# blank means every phone outside production and NO phone in production.
# The code is never logged.
AGENT_OTP_DUMMY_ENABLED=false
AGENT_OTP_DUMMY_PHONES=
AGENT_OTP_DUMMY_CODE=

# ─── Dummy-OTP authentication (TEMPORARY) ────────────────────────────
#
# Scaffolding so signup works before Firebase Phone Auth SMS billing is
# enabled. It is a real authentication bypass: whoever knows a permitted
# number can sign in as it with no credential. Only ever list throwaway test
# numbers, never a real member's.
#
# LOCAL DEVELOPMENT — any well-formed number, no list to maintain. Requires
# NODE_ENV to not be "production"; setting this in production grants nothing,
# by design.
DEV_AUTH_ENABLED=false

# Admits any well-formed E.164 number in EVERY environment, NODE_ENV=production
# included, unless DUMMY_OTP_PHONES below is non-empty (then only those numbers).
# There is no ownership check: anyone who can reach the API can sign in as any
# number. Only use it while every account in the database is disposable.
#
# A debug Flutter build always uses the dummy OTP (see otp_verifier.dart), so
# whichever backend that build points at must have one of these two flags set
# or every signup ends in "not enabled for this number on this server".
DUMMY_OTP_ENABLED=true

# OPTIONAL narrowing for DUMMY_OTP_ENABLED=true, in every environment.
# Non-empty: only the listed E.164 numbers are admitted. Empty or unset: NOT
# narrowed, so ANY well-formed number is admitted (it does not block everyone).
# Malformed entries are dropped, so a typo shrinks the list rather than
# widening it. Has no effect on DEV_AUTH_ENABLED.
DUMMY_OTP_PHONES=

# When billing is enabled, set this to true. It overrides both flags above and
# restores real Firebase Phone Auth with no code change. The Flutter build
# takes the matching --dart-define=USE_REAL_OTP=true.
USE_REAL_OTP=false
