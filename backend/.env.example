# Copy this file to .env.local and fill in real values for your machine.
# Never commit real secrets — this file must only ever contain dummy values.

NODE_ENV=development
PORT=3000
WEBSOCKET_PORT=3001

# Database — choose ONE of the two options below.
#
# (A) Shared/managed Postgres (e.g. Neon): set a single DATABASE_URL. It is
#     used verbatim by both the app and the Prisma CLI, and carries its own SSL
#     mode. This is all a teammate needs to point at the shared team database:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# (B) Local Postgres: leave DATABASE_URL unset and fill in the discrete fields.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=nenjam_matrimony

REDIS_HOST=localhost
REDIS_PORT=6379

ELASTICSEARCH_NODE=http://localhost:9200

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-secret

LOG_LEVEL=debug

# Progressive Discover-feed fallback (ProgressiveFallbackStrategy). If a
# user's strict partner preferences return zero profiles, the feed gradually
# widens the search (age, then city, caste, mother tongue, education,
# profession, income, age again, then gender-only) until it finds matches or
# runs out of tiers. All optional — defaults shown below.
# FALLBACK_ENABLED=true
# AGE_RELAX_STEP_1=2
# AGE_RELAX_STEP_2=5
# MAX_FALLBACK_TIER=10
