# ===================================================================
# Nenjam Matrimony — backend environment TEMPLATE
# ===================================================================
# This file is COMMITTED and must only ever contain placeholder values.
# It is the single tracked exception to the .env* ignore rules — see
# .gitignore. Never paste a real password, key, token or connection
# string into this file.
#
# Setup:
#   cp .env.example .env      # then fill in real values
#
# Load order (libs/config/src/config.module.ts): ['.env.local', '.env'].
# .env is the normal per-developer file; .env.local overrides it
# per-variable when present. Both are gitignored. The Prisma CLI reads
# the same two files in the same order via prisma.config.ts.
#
# Validation: libs/config/src/validation.ts (Joi). The app fails fast at
# boot listing every invalid/missing variable at once.
# ===================================================================

# ---------- Runtime ----------
# NODE_ENV drives more than logging: ElasticsearchService only tolerates
# an unreachable cluster when this is "development" — in production a
# failed Elasticsearch ping aborts startup.
# One of: development | production | test | staging   (default: development)
NODE_ENV=development
# HTTP port for the API app.                          (default: 3000)
PORT=3000
# Port for the standalone websocket app (apps/websocket). (default: 3001)
WEBSOCKET_PORT=3001
# One of: error | warn | info | debug | verbose        (default: info)
LOG_LEVEL=debug

# ---------- Database (PostgreSQL / Neon) ----------
# Choose ONE of the two options below.
#
# (A) Managed/shared Postgres (e.g. Neon) — set DATABASE_URL only. It is
#     used verbatim by both the app and the Prisma CLI and carries its own
#     SSL mode. This takes precedence over the discrete fields in (B).
DATABASE_URL="postgresql://username:password@host.region.aws.neon.tech/database?sslmode=require"
#
# (B) Local Postgres — leave DATABASE_URL empty and fill these in instead.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=nenjam_matrimony

# ---------- Redis ----------
# Choose ONE of the two options below.
#
# (A) Managed Redis (e.g. Redis Cloud) — set REDIS_URL only. Use redis://
#     or rediss:// (ioredis auto-detects TLS from the scheme). Takes
#     precedence over the discrete fields in (B).
REDIS_URL=redis://username:password@host.redis.io:6379
#
# (B) Local Redis / Memurai — leave REDIS_URL empty and fill these in.
#     A blank value is treated as absent, not as a validation error.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=

# ---------- Elasticsearch ----------
# REQUIRED and must be a valid URI, even if no cluster is running:
# validation rejects a missing/blank value. In development an unreachable
# cluster only logs a warning and search falls back to the Postgres
# strategy; in production it aborts startup.
ELASTICSEARCH_NODE=https://localhost:9200
# Index name. Currently unused by application code — kept for parity with
# deployment configs. Safe to leave at the default.
ELASTICSEARCH_INDEX=profiles
# Basic Auth for a secured cluster. Leave both blank to connect without auth.
ELASTICSEARCH_USERNAME=your_elasticsearch_username
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# ---------- SMTP (transactional email) ----------
# REQUIRED (host + port). For local development point these at a mail
# catcher such as MailHog/Mailpit on 127.0.0.1:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ---------- JWT ----------
# REQUIRED, minimum 16 characters. Use a long random value and a DIFFERENT
# one per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_min_16_chars

# ---------- CORS ----------
# Optional. Comma-separated list of origins allowed to call the API
# cross-origin (the deployed web frontend's domain(s)), e.g.:
#   CORS_ORIGINS=https://app.your-domain.com,https://your-domain.com
# Left unset: development reflects the request origin (today's behavior);
# production/staging reject all cross-origin requests until this is set.
CORS_ORIGINS=

# ---------- Firebase Admin SDK ----------
# Optional: the app boots without these, but every endpoint behind
# FirebaseAuthGuard returns 500 until they are set. Values come from the
# service-account JSON in Firebase Console > Project settings > Service accounts.
#
# FIREBASE_PRIVATE_KEY must stay double-quoted and keep its literal \n
# escape sequences — configuration.ts converts them to real newlines before
# handing the key to cert(). Paste the private_key field verbatim.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ---------- AWS S3 (profile photos + verification documents) ----------
# Optional: the app boots without these; only the photo/document upload
# endpoints need them, and S3Service returns a clear error if a request
# reaches it unconfigured. Prefer an IAM user scoped to just this bucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# ---------- Email (Resend) ----------
# Optional. Left blank, the app boots and MailModule binds a no-op provider
# that queues, renders and logs an EmailLog row without calling out — so local
# dev and CI exercise the whole pipeline without a third-party secret.
# Format is still validated when present: it must look like "re_...".
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# "user@domain.com" or "Display Name <user@domain.com>".
# onboarding@resend.dev needs no domain verification but only delivers to the
# Resend account owner's own address — fine for development, not for real users.
MAIL_FROM=Nenjam Matrimony <onboarding@resend.dev>
# Optional Reply-To. Unset, replies go to MAIL_FROM.
MAIL_REPLY_TO=
# Shown in every template footer.
MAIL_SUPPORT_EMAIL=support@your-domain.com
# Absolute URL to the logo. Unset, templates fall back to a text wordmark.
MAIL_LOGO_URL=
# Base URL for the CTA buttons rendered into templates.
APP_WEB_URL=https://your-domain.com

# ---------- Discover-feed progressive fallback ----------
# Tunes how far ProgressiveFallbackStrategy widens a search that returns
# zero strict matches. All optional with sane defaults.
FALLBACK_ENABLED=true
AGE_RELAX_STEP_1=2
AGE_RELAX_STEP_2=5
MAX_FALLBACK_TIER=10

# ─── Dummy-OTP authentication (TEMPORARY) ────────────────────────────
#
# Scaffolding so signup works before Firebase Phone Auth SMS billing is
# enabled. It is a real authentication bypass: whoever knows a permitted
# number can sign in as it with no credential. Only ever list throwaway test
# numbers, never a real member's.
#
# LOCAL DEVELOPMENT — any well-formed number, no list to maintain. Requires
# NODE_ENV to not be "production"; setting this in production grants nothing,
# by design.
DEV_AUTH_ENABLED=false

# Off production this does the same as DEV_AUTH_ENABLED: any well-formed
# number, no whitelist. IN PRODUCTION it admits only the numbers listed below.
#
# A debug Flutter build always uses the dummy OTP (see otp_verifier.dart), so
# whichever backend that build points at must have one of these two flags set
# or every signup ends in "not enabled for this number on this server".
DUMMY_OTP_ENABLED=true

# Comma-separated E.164 numbers permitted when DUMMY_OTP_ENABLED=true AND
# NODE_ENV=production. Ignored off production, where any well-formed number is
# accepted. In production, empty or unset admits nobody; malformed entries are
# dropped, so a typo shrinks the list rather than widening it.
DUMMY_OTP_PHONES=

# When billing is enabled, set this to true. It overrides both flags above and
# restores real Firebase Phone Auth with no code change. The Flutter build
# takes the matching --dart-define=USE_REAL_OTP=true.
USE_REAL_OTP=false
