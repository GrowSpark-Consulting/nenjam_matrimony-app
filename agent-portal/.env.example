# Copy to .env.local for local development. Never commit real values.
# Everything here is compiled into the public JavaScript: never put a secret in
# a VITE_* variable.
#
# Base URL of the Nenjam API. Required unless VITE_USE_MOCKS=true.
#   Production: https://nenjam-matrimony.onrender.com
#   Local backend: http://127.0.0.1:3000 (http is allowed for localhost in
#   development builds only)
VITE_API_BASE_URL=
#
# "true" runs the portal on the in-browser mock API. Development only: a
# production build refuses it, and the mock is not included in the bundle.
VITE_USE_MOCKS=true
