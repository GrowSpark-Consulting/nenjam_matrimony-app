# Nenjam Matrimony — Environment Configuration Example
# Do not put real production secrets here. Copy this file to .env.<environment>
#
# NOTE: the API base URL deliberately does NOT live here. It is a single
# compile-time constant (AppConstants.apiBaseUrl); override it per build with
#   --dart-define=API_BASE_URL=https://...

ENABLE_LOGGING=true
S3_BUCKET_NAME=nenjam-assets-dev
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
