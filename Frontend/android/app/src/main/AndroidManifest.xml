<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Firebase Auth, Google Sign-In, the NestJS API and
         image loading. Flutter's template declares this only in the debug and
         profile manifests (they need it for the VM service), which leaves a
         RELEASE build with no INTERNET permission at all — every network call,
         Google Sign-In included, fails silently on a release APK. Declared
         here so it is present in every build type. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Camera capture for profile/chat photos (Profile > Camera, Chat > Camera). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Runtime notification permission on Android 13+ (API 33); requested only
         after the user opts in via the in-app "Enable Notifications" prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Voice message recording (Chat composer's mic button). Requested only
         when the user actually taps to record, never at startup. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Device location for "Near Me" (proximity search). Both are declared
         because Android 12+ shows the user a Precise/Approximate choice in one
         dialog: granting only COARSE is a supported outcome the app handles
         (the fix is just less accurate), not an error. Requested only when the
         user opens Near Me, never at startup, and the app works without it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Background location is deliberately NOT declared: Near Me reads a
         position only while the user is looking at the screen. -->
    <!-- Gallery photo selection deliberately requests NO storage/media
         permission — image_picker uses the system Photo Picker, which needs
         none, so READ_MEDIA_IMAGES/READ_EXTERNAL_STORAGE are intentionally
         NOT declared here. -->

    <application
        android:label="nenjam_matrimony"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM: channel/icon used when a push auto-displays in the system
             tray (app backgrounded/terminated) — id matches
             LocalNotificationService's channel, used for foreground pushes. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nenjam_default_channel" />
        <!-- Monochrome status-bar icon (res/drawable/ic_notification.xml) —
             NOT @mipmap/ic_launcher. Android masks notification icons to a
             flat silhouette using only their alpha channel, so a full-color
             adaptive launcher icon renders as an indistinct white blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
